# DimensionWorks server defaults for FTB Chunks.
# Claiming, map, waypoints, and claim protection remain enabled.
# A zero per-player limit blocks force-loading unless a numeric permission overrides it.

{
  disable_protection: false
  force_disable_minimap: false
  force_load_mode: "never"
  max_force_loaded_chunks: 0
  hard_team_force_limit: 0
}
